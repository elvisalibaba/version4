# HolisticBooks API - production template for api.aba.cd
# Copy to backend/.env on the production server and fill secrets there.
# NEVER commit the real .env file.

APP_NAME="HolisticBooks API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.aba.cd
FRONTEND_URL=https://holistique-books.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DIRECTORY=livewire-tmp
PUBLIC_FILES_ROOT=
PUBLIC_FILES_URL=

# Le front et l'app mobile s'authentifient par jeton (Bearer) : aucun domaine "stateful".
SANCTUM_STATEFUL_DOMAINS=
# Durée de vie des jetons de connexion (30 jours = cookie hb_session du front).
SANCTUM_EXPIRATION_MINUTES=43200
# Clé partagée avec le serveur Next.js (même valeur dans son .env, JAMAIS en NEXT_PUBLIC_).
# Permet à l'API de connaître la vraie IP des visiteurs pour les limites de débit.
# Générez une valeur aléatoire d'au moins 40 caractères.
FRONTEND_PROXY_SECRET=

BOOK_PDFINFO_BINARY=pdfinfo
BOOK_PDFTOPPM_BINARY=pdftoppm
BOOK_PDF_IMAGICK_ENABLED=true
BOOK_COVER_SIZE=1600
BOOK_PDF_PROCESS_TIMEOUT=30
# Rendus PDF simultanés maximum (protège les workers PHP de l’hébergement).
BOOK_PDF_MAX_CONCURRENT_RENDERS=3
BOOK_ENGAGEMENT_DEDUPLICATION_HOURS=24

MAIL_MAILER=failover
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
SUPPORT_EMAIL=
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# EasyPay production
EASYPAY_BASE_URL=https://www.e-com-easypay.com
EASYPAY_MODE=v1
EASYPAY_CORRELATION_ID=
EASYPAY_TOKEN=

# Author Studio / royalties
AUTHOR_DEFAULT_ROYALTY_RATE=0.70
AUTHOR_PAYOUT_DELAY_DAYS=30
AUTHOR_MINIMUM_PAYOUT=10
AUTHOR_DEFAULT_CURRENCY=USD

# Optional S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
