APP_NAME=HolisticBooks API
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=holisticbooks
DB_USERNAME=root
DB_PASSWORD=

BOOK_PDFINFO_BINARY=pdfinfo
BOOK_PDFTOPPM_BINARY=pdftoppm
BOOK_COVER_SIZE=1600
BOOK_PDF_PROCESS_TIMEOUT=30
BOOK_ENGAGEMENT_DEDUPLICATION_HOURS=24

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_FILES_ROOT=
PUBLIC_FILES_URL=
SANCTUM_STATEFUL_DOMAINS=localhost:3000,holistique-books.com,www.holistique-books.com
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
SUPPORT_EMAIL=
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# EasyPay
EASYPAY_BASE_URL=https://www.e-com-easypay.com
EASYPAY_MODE=sandbox
EASYPAY_CORRELATION_ID=
EASYPAY_TOKEN=
# Compatibilité ancienne configuration, à supprimer après migration :
EASYPAY_PUBLISHABLE_KEY=
# IPN à renseigner dans le portail marchand en production :
# https://api.aba.cd/api/v1/payments/easypay/notify

# Author Studio / royalties
AUTHOR_DEFAULT_ROYALTY_RATE=0.70
AUTHOR_PAYOUT_DELAY_DAYS=30
AUTHOR_MINIMUM_PAYOUT=10
AUTHOR_DEFAULT_CURRENCY=USD
