NEXT_PUBLIC_APP_URL=
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
ADMIN_NOTIFY_EMAIL=
NEXT_PUBLIC_ANDROID_APK_URL=
