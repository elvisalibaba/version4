# /opt/holisticbooks/env/api.env — API Laravel (droits 600, propriétaire root).
# Les lignes marquées « généré » sont remplies sur le serveur par deploy.sh init-secrets,
# sans jamais être affichées. Les autres sont à compléter à la main.

APP_NAME="Holistique Books"
APP_ENV=production
APP_DEBUG=false
# Généré
APP_KEY=
APP_URL=https://vps-api.aba.cd
FRONTEND_URL=https://vps.holistique-books.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=holisticbooks
DB_USERNAME=holisticbooks
# Généré (identique à MYSQL_PASSWORD de db.env)
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=vps.holistique-books.com
SANCTUM_EXPIRATION_MINUTES=43200
# Généré (identique à celui de web.env)
FRONTEND_PROXY_SECRET=

CACHE_STORE=database
QUEUE_CONNECTION=database
# Le conteneur `worker` traite la file : pas de queue:work lancé chaque minute.
QUEUE_SCHEDULED_WORKER=false
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_MAX_KILOBYTES=51200

BOOK_PDFINFO_BINARY=pdfinfo
BOOK_PDFTOPPM_BINARY=pdftoppm
BOOK_PDF_IMAGICK_ENABLED=false
BOOK_PDF_MAX_CONCURRENT_RENDERS=2

# Courrier : serveur Hi-Tech, par smtp.aba.cd (enregistrement DNS hors proxy Cloudflare).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.aba.cd
MAIL_PORT=587
# À compléter : boîte e-mail @aba.cd du cPanel
MAIL_USERNAME=
# À compléter
MAIL_PASSWORD=
# À compléter : adresse @aba.cd
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Holistique Books"
# À compléter
SUPPORT_EMAIL=

# EasyPay : laissées vides, à remplir avec les valeurs régénérées.
EASYPAY_BASE_URL=
EASYPAY_MODE=
EASYPAY_CORRELATION_ID=
EASYPAY_TOKEN=
EASYPAY_PUBLISHABLE_KEY=
