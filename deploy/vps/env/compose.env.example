# /opt/holisticbooks/.env — réglages de docker compose et de deploy.sh (aucun secret ici).

# Commit déployé (rempli par deploy.sh) et environnement du front.
HB_IMAGE_TAG=
HB_WEB_ENV=test
HB_WEB_IMAGE_TAG=

# Noms publics servis par le Caddy partagé (Cloudflare proxifié, certificat d'origine).
#   test       : vps.holistique-books.com, vps-api.aba.cd, vps-apex.holistique-books.com
#   production : www.holistique-books.com, api.aba.cd, holistique-books.com
HB_FRONT_HOST=vps.holistique-books.com
HB_API_HOST=vps-api.aba.cd
# Nom redirigé en 301 vers https://HB_FRONT_HOST (domaine sans www en production).
HB_REDIRECT_HOST=vps-apex.holistique-books.com

# Certificats d'origine Cloudflare (une paire par zone), dans /opt/edge-sites/certs/holisticbooks/.
HB_FRONT_CERT=holistique-books.com
HB_API_CERT=aba.cd

# Conteneur Caddy qui importe /opt/edge-sites/*.caddy (projet Ibala Pay).
EDGE_CADDY_CONTAINER=ibalapay-staging-caddy-1
