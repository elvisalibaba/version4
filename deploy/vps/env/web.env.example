# /opt/holisticbooks/env/web.env — serveur Next.js (droits 600, propriétaire root).
# NEXT_PUBLIC_* ne sont PAS lues ici : elles sont figées dans l'image au build.

# Appels serveur vers Laravel par le réseau interne (nginx force l'hôte public de l'API).
API_URL=http://nginx
APP_BASE_URL=https://vps.holistique-books.com
# Généré (identique à celui de api.env)
FRONTEND_PROXY_SECRET=

# Formulaire de contact : même serveur de courrier que Laravel.
SMTP_HOST=smtp.aba.cd
SMTP_PORT=587
# À compléter
SMTP_USER=
# À compléter
SMTP_PASS=
# À compléter : adresse @aba.cd
SMTP_FROM=
# À compléter
CONTACT_TO=
# À compléter
ADMIN_NOTIFY_EMAIL=

# Dons EasyPay (lib/payments/cinetpay-donations.ts) : vides, à remplir plus tard.
EASYPAY_BASE_URL=
EASYPAY_MODE=
EASYPAY_CID=
EASYPAY_CORRELATION_ID=
EASYPAY_TOKEN=
EASYPAY_PUBLISHABLE_KEY=
